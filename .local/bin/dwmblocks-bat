#!/bin/sh
BUTTON="${BUTTON:-$BLOCK_BUTTON}"

case "$BUTTON" in
    1) 
        #bat_info=$(cat /sys/class/power_supply/BAT?/uevent 2>/dev/null | grep -E "POWER_SUPPLY_(STATUS|CAPACITY|POWER_NOW|VOLTAGE_NOW)" | sed 's/POWER_SUPPLY_//g')
        bat_info=$(cat /sys/class/power_supply/BAT?/uevent 2>/dev/null | awk -F'=' '
        /POWER_SUPPLY_(STATUS|CAPACITY|POWER_NOW|VOLTAGE_NOW)/ {
            sub(/^POWER_SUPPLY_/, "");
            if ($1 == "VOLTAGE_NOW") $2 = sprintf("%.2f V", $2 / 1000000);
                if ($1 == "POWER_NOW") $2 = sprintf("%.2f W", $2 / 1000000);
                    print $1 "=" $2;
                }')
        notify-send -r 1002 "Battery Info" "$bat_info"
        ;;
esac

# Loop through all attached batteries and format the info
for battery in /sys/class/power_supply/BAT?*; do
	# If non-first battery, print a space separator.
	[ -n "${capacity+x}" ] && printf " "
	# Sets up the status and capacity
	case "$(cat "$battery/status" 2>&1)" in
		"Full") status="󱈏 " ;;
		"Discharging") status="󰂌 " ;;
		"Charging") status="󰂄 " ;;
		"Not charging") status="󱉝 " ;;
		"Unknown") status="󰂑 " ;;
		*) exit 1 ;;
	esac
	capacity="$(cat "$battery/capacity" 2>&1)"
	# Will make a warn variable if discharging and low
	#[ "$status" = "󰂌" ] && [ "$capacity" -le 25 ] && warn="󰂃"
	# Prints the info
	printf "%s%d%%%s" "$warn" "$capacity" "$status" ; unset warn
done && printf "\\n"
